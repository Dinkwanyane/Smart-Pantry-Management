<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/textPantryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:visibility="visible"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />


    <TextView
        android:id="@+id/textPantrySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your saved ingredients"
        android:textSize="16sp"
        android:textColor="#64748B"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty. Add an ingredient to get started."
        android:textSize="16sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>
